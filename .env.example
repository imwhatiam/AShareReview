# Django runtime
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_TIME_ZONE=Asia/Shanghai
# Level for the data-pipeline management commands (sync_* / refresh_* / fetch_*).
DATA_COMMAND_LOG_LEVEL=INFO
# Level for the Django app itself: core, the four business modules and the web
# access log. Set to WARNING in production when only problems should be kept.
DJANGO_LOG_LEVEL=INFO
# Access-log/application-log rendering: plain = one human-readable line of
# key=value pairs; json = one JSON object per line, for a log collector.
DJANGO_LOG_FORMAT=plain
# A web request slower than this many milliseconds is logged as WARNING instead
# of INFO. The read paths build a missing derived day on demand, so a page that
# silently spent 8 seconds computing must announce itself in the log.
DJANGO_REQUEST_LOG_SLOW_MS=1000
# Who receives the 5xx alert mail. Blank (the default) means "nobody" — Django's
# ``mail_admins`` then silently does nothing, so an unhandled 500 would produce no
# alert at all. Entries are ``Name:email@example.com``, comma separated, and a
# malformed entry fails the boot instead of dropping the address. Alerts only fire
# with DEBUG=false; locally the console MAILERS backend prints the body instead.
DJANGO_ADMINS=
DJANGO_SERVER_EMAIL=root@localhost

# Per-database SQLite paths, relative to the repository root unless absolute
CORE_DATABASE_PATH=backend/data/core.sqlite3
KAIPANLA_DATABASE_PATH=backend/data/kaipanla.sqlite3
STOCK_MOVES_DATABASE_PATH=backend/data/stock_moves.sqlite3
SECTOR_MOMENTUM_DATABASE_PATH=backend/data/sector_momentum.sqlite3
HUNDRED_DAY_DATABASE_PATH=backend/data/hundred_day.sqlite3

# Common filesystem cache and bounded web-request REMOTE repair
# These budgets apply to the sector-fund-flow repair path only. The three
# after-hours modules (stock_moves / sector_momentum / hundred_day) generate a
# missing day on demand from local data and never read these values, because
# that path makes no upstream request and has no row budget.
FILE_CACHE_DIRECTORY=backend/cache
LOCK_DIRECTORY=backend/data/locks
# A killed process (SIGKILL / OOM / cron timeout) cannot run its cleanup, so a
# dataset lock can survive it and block that dataset forever. Locks carry their
# holder (host + PID + creation time); a lock whose holder is dead on this host
# is reclaimed immediately, and a lock older than this many seconds is reclaimed
# even when the holder cannot be checked. Set to 0 to allow only the dead-holder
# case. Keep it far above the longest real run (the full industry snapshot is
# about four minutes).
LOCK_STALE_SECONDS=21600
# Retry hint handed back in the 202/503 body of the sector-fund-flow read. It is
# NOT a time budget: it does not change how long that fetch may take (that is
# REMOTE_REPAIR_HARD_TIMEOUT_SECONDS below). Renamed from
# REMOTE_REPAIR_TARGET_SECONDS, which read like a budget and was not one.
REMOTE_REPAIR_RETRY_AFTER_SECONDS=3
REMOTE_REPAIR_HARD_TIMEOUT_SECONDS=5
# Switch for the web-request repair of the sector-fund-flow snapshot. A repair
# is a single bounded fetch (one page, no retries), so this is a plain on/off
# switch — there is no attempt budget to tune. Set to 0 to serve only what is
# already stored. This is the on/off half of the chain; the timeout above is the
# only other half (the retry hint is a hint, not a knob). A row cap used to live
# here too (REMOTE_REPAIR_MAX_ROWS=1000) but one page never exceeds 80 rows, so
# it could not fire; it is now the REPAIR_MAX_ROWS constant in
# kaipanla/services/read_path.py.
REMOTE_REPAIR_ENABLED=1

# Statically enabled business modules
ENABLED_MODULES=kaipanla,stock_moves,sector_momentum,hundred_day

# Hithink Finance REST API
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_API_KEY=replace-with-api-key
HITHINK_FINANCE_TIMEOUT_SECONDS=10
HITHINK_FINANCE_REQUEST_DELAY_SECONDS=1
HITHINK_FINANCE_MAX_RETRIES=2
# Stock-master sync deactivates every stock the upstream list omits, so a
# truncated response would silently retire part of the market. A response below
# this share of the currently active stocks aborts the sync instead of writing.
# Only applies once a previous sync exists.
STOCK_MASTER_MIN_COVERAGE_RATIO=0.9
# Kaipanla's 881 industry lists still use the pre-2026 Beijing Stock Exchange codes,
# so its snapshot cannot classify any 920xxx stock. When enabled, the industry
# snapshot command fetches Hithink's industry constituents (one request per shared
# industry code) and adds the missing members. Set to 0 to keep the sync offline.
HITHINK_INDUSTRY_BACKFILL_ENABLED=1
# Intraday refresh walks the whole-market quote snapshot in pages. A page walk
# that covers less than this share of the active market is rejected outright
# instead of being published as a "complete" day.
INTRADAY_QUOTE_PAGE_SIZE=1000
INTRADAY_QUOTE_MIN_COVERAGE_RATIO=0.95

# Kaipanla endpoints, optional credentials, and request behaviour
# Leave any KPL_* value blank to omit that field from every Kaipanla request.
KAIPANLA_API_URL=https://apphwshhq.longhuvip.com/w1/api/index.php
# Industry parent/child/stock snapshots use the historical endpoint.
KAIPANLA_INDUSTRY_API_URL=https://apphis.longhuvip.com/w1/api/index.php
KPL_DEVICE_ID=
KPL_USER_ID=
KPL_TOKEN=
KPL_VERSION=5.23.0.4
KPL_API_VERSION=w44
KPL_PHONE_OS_NEW=1
KAIPANLA_TIMEOUT_SECONDS=10
KAIPANLA_REQUEST_DELAY_SECONDS=1
KAIPANLA_MAX_RETRIES=2

# Kaipanla industry snapshot contract (RealRankingInfo -> ZhiShuStockList_W8)
KAIPANLA_PARENT_INDUSTRY_ACTION=RealRankingInfo
KAIPANLA_STOCK_LIST_ACTION=ZhiShuStockList_W8
KAIPANLA_INDUSTRY_CONTROLLER=ZhiShuRanking
# 板块列表端点的 st 有约 70 的隐性上限：st>=75 时上游静默返回空列表，客户端会当成“分页结束”。
# 保持 30，不要为提速调大。
KAIPANLA_INDUSTRY_PARENT_PAGE_SIZE=30
# 成分股端点的 st 无实际上限。实测 st=300 时多页结果去重后与单页一致，
# 已用它把全量同步的成分股分页请求压到约 42%。
KAIPANLA_INDUSTRY_STOCK_PAGE_SIZE=300
KAIPANLA_INDUSTRY_PARENT_ORDER=1
KAIPANLA_INDUSTRY_PARENT_TYPE=1
# ZSType 是选板块族的开关：4=881xxx 行业（当前），7=80xxxx 概念题材，5=885/886 概念。
# 它必须与 KAIPANLA_FLOW_ZS_TYPE 指同一个族，且配套的 TYPE 参数固定为 1。
KAIPANLA_INDUSTRY_PARENT_ZS_TYPE=4
KAIPANLA_INDUSTRY_STOCK_ORDER=1
KAIPANLA_INDUSTRY_STOCK_TSZB=0
KAIPANLA_INDUSTRY_STOCK_OLD=1
KAIPANLA_INDUSTRY_STOCK_IS_ZZ=0
KAIPANLA_INDUSTRY_STOCK_TYPE=6
KAIPANLA_INDUSTRY_STOCK_IS_KZZ_TYPE=0
# Leave blank to request the latest trading day. The history endpoint rejects a
# date without a session (errcode 1020 参数出错), so weekends and holidays must
# not fall back to the local calendar date.
KAIPANLA_INDUSTRY_DATE=

# Login/session/CSRF cookie policy
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://example.com

# Failed-login budget for /api/core/login/, per (client address, username).
# After this many rejections the pair gets 429 TOO_MANY_ATTEMPTS until the window
# expires; a successful login clears the counter. The counter lives in Django's
# cache, which is per-process unless CACHES points at a shared backend.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Local development only: Vite forwards /api/ to this Django origin.
VITE_DEV_BACKEND_ORIGIN=http://127.0.0.1:8000

# File cache policy
FILE_CACHE_ENABLED=true
FILE_CACHE_TTL_SECONDS=300
FILE_CACHE_MAX_BYTES=10485760

# Kaipanla request parameters
KAIPANLA_FLOW_ACTION=RealRankingInfo
KAIPANLA_FLOW_CONTROLLER=ZhiShuRanking
KAIPANLA_FLOW_PAGE_SIZE=80
KAIPANLA_FLOW_ORDER=1
KAIPANLA_FLOW_TYPE=1
# 与 KAIPANLA_INDUSTRY_PARENT_ZS_TYPE 同族：4=881xxx 行业（当前）。
KAIPANLA_FLOW_ZS_TYPE=4
KAIPANLA_FLOW_MAX_PAGES=20
KAIPANLA_USER_AGENT=Dalvik/2.1.0 (Linux; U; Android 12; ALN-AL00 Build/W528JS)
