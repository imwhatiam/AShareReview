# Django runtime
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_TIME_ZONE=Asia/Shanghai

# Per-database SQLite paths, relative to the repository root unless absolute
CORE_DATABASE_PATH=backend/data/core.sqlite3
KAIPANLA_DATABASE_PATH=backend/data/kaipanla.sqlite3
EASTMONEY_DATABASE_PATH=backend/data/eastmoney.sqlite3
STOCK_MOVES_DATABASE_PATH=backend/data/stock_moves.sqlite3
SECTOR_MOMENTUM_DATABASE_PATH=backend/data/sector_momentum.sqlite3
HUNDRED_DAY_DATABASE_PATH=backend/data/hundred_day.sqlite3

# Common filesystem cache and bounded web-request repair
FILE_CACHE_DIRECTORY=backend/cache
LOCK_DIRECTORY=backend/data/locks
REMOTE_REPAIR_TARGET_SECONDS=3
REMOTE_REPAIR_HARD_TIMEOUT_SECONDS=5
REMOTE_REPAIR_MAX_ROWS=1000

# Statically enabled business modules
ENABLED_MODULES=kaipanla,eastmoney,stock_moves,sector_momentum,hundred_day

# Hithink Finance REST API
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_API_KEY=replace-with-api-key
HITHINK_FINANCE_TIMEOUT_SECONDS=10
HITHINK_FINANCE_REQUEST_DELAY_SECONDS=1
HITHINK_FINANCE_MAX_RETRIES=2

# Kaipanla endpoints and credentials
KAIPANLA_API_URL=https://apphwshhq.longhuvip.com/w1/api/index.php
KPL_DEVICE_ID=replace-with-device-id
KPL_USER_ID=
KPL_TOKEN=
KAIPANLA_TIMEOUT_SECONDS=10
KAIPANLA_REQUEST_DELAY_SECONDS=1
KAIPANLA_MAX_RETRIES=2

# Eastmoney endpoint and request behaviour
EASTMONEY_API_URL=https://push2.eastmoney.com/api/qt/clist/get
EASTMONEY_TIMEOUT_SECONDS=10
EASTMONEY_REQUEST_DELAY_SECONDS=1
EASTMONEY_MAX_RETRIES=2

# Login/session/CSRF and browser-origin policy
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com

# File cache policy
FILE_CACHE_ENABLED=true
FILE_CACHE_TTL_SECONDS=300
FILE_CACHE_MAX_BYTES=10485760
REMOTE_REPAIR_MAX_ATTEMPTS=1

# Hithink rate limits
HITHINK_FINANCE_MAX_CONCURRENCY=1

# Kaipanla request parameters
KAIPANLA_FLOW_ACTION=RealRankingInfo
KAIPANLA_FLOW_CONTROLLER=ZhiShuRanking
KAIPANLA_FLOW_PAGE_SIZE=80
KAIPANLA_PARENT_INDUSTRY_ACTION=RealRankingInfo
KAIPANLA_CHILD_INDUSTRY_ACTION=SonPlate_Info
KAIPANLA_STOCK_LIST_ACTION=ZhiShuStockList_W8

# Eastmoney request parameters
EASTMONEY_UT=8dec03ba335b81bf4ebdf7b29ec27d15
EASTMONEY_PAGE_SIZE=50
EASTMONEY_FIELDS=f12,f14,f2,f3,f62,f184,f66,f69,f72,f75,f78,f81,f84,f87,f204,f205,f124
EASTMONEY_INFLOW_FS=m:90+s:8+f:!50
EASTMONEY_OUTFLOW_FS=m:90+s:8+f:!50
EASTMONEY_RANKING_INTERVAL_SECONDS=1
